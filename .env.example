# BOT Chain Testnet configuration
NEXT_PUBLIC_BOTCHAIN_CHAIN_ID=968
NEXT_PUBLIC_BOTCHAIN_MAINNET_CHAIN_ID=677
NEXT_PUBLIC_BOTCHAIN_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOTCHAIN_EXPLORER_URL=https://scan.bohr.life/tx/
BOTCHAIN_RPC_URL=https://rpc.bohr.life

# Public network configuration (safe for browser only when the URL contains no private API key).
# The verifier can use these keyless defaults; operators may replace them with a more reliable RPC.
NEXT_PUBLIC_SEPOLIA_CHAIN_ID=11155111
NEXT_PUBLIC_CREDITCOIN_CHAIN_ID=102031
NEXT_PUBLIC_ATTESTCOIN_CHAIN_KEY=1
NEXT_PUBLIC_SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_CREDITCOIN_EXPLORER_URL=https://creditcoin-testnet.blockscout.com
# Hosted deployment value: https://<render-service>.onrender.com/api/v1
# Local default: http://localhost:3000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_CURRENT_WORKER_TOURNAMENT_ID=0x38068ece64fe32ff70d3de7445ec16350ff2f661e13dffbdccd91bbe96f2ae47

# Current post-fix addresses from evidence/current-deployment.json. Historical evidence
# continues to use evidence/live-deployment.json and its original addresses.
NEXT_PUBLIC_RESULT_REGISTRY_ADDRESS=0xDdDA859AC766E3eaE59Dc7b7B85465610aF90a3f
NEXT_PUBLIC_RESULT_RULES_HASH=0x7564123213f3cffdfa6237a0067717f6f1a13dc65a0b69e6960cbe5ca8c94331
NEXT_PUBLIC_SOURCE_FINALIZER_ADDRESS=0x0d6FAee78dFF4380E77D0e412F5Cddd942673719
NEXT_PUBLIC_PRIZE_VAULT_ADDRESS=0x270B97d063668d9B2107d15E08a81Af2318E7edC
NEXT_PUBLIC_PRIZERAIL_ASC_ADDRESS=0xD5226c2eC2C6958A9785C29DADBc28810f718CCf
NEXT_PUBLIC_PRIZE_TOKEN_ADDRESS=0x9366e8298799A132D20F51021d6Ef3A99D57817C

# Server/worker network configuration
# Render platform only: NODE_VERSION=22.22.3; local Node selection is external to .env.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
ATTESTCOIN_SOURCE_CHAIN_KEY=1
ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network
ATTESTCOIN_BLOCK_PROVER_ADDRESS=0x0000000000000000000000000000000000000FD2
ATTESTCOIN_CHAIN_INFO_ADDRESS=0x0000000000000000000000000000000000000fd3

# Server-only secrets. Never prefix with NEXT_PUBLIC_. Never commit real values.
DEPLOYER_PRIVATE_KEY=0xYOUR_DEDICATED_TESTNET_ONLY_DEPLOYER_KEY
FINALIZER_PRIVATE_KEY=0xYOUR_DEDICATED_TESTNET_ONLY_FINALIZER_KEY
ORGANIZER_PRIVATE_KEY=0xYOUR_DEDICATED_TESTNET_ONLY_ORGANIZER_KEY
PLAYER_ONE_PRIVATE_KEY=0xYOUR_DEDICATED_TESTNET_ONLY_PLAYER_ONE_KEY
PLAYER_TWO_PRIVATE_KEY=0xYOUR_DEDICATED_TESTNET_ONLY_PLAYER_TWO_KEY
WORKER_PRIVATE_KEY=0xYOUR_DEDICATED_TESTNET_ONLY_WORKER_KEY
PAYOUT_TRIGGER_PRIVATE_KEY=0xYOUR_DEDICATED_TESTNET_ONLY_PAYOUT_TRIGGER_KEY
# Optional explicit role reuse for a local/demo run. Reuse is never implicit.
# ROLE_REUSE_FINALIZER=DEPLOYER
# ROLE_REUSE_ORGANIZER=DEPLOYER
# ROLE_REUSE_PLAYER_ONE=DEPLOYER
# ROLE_REUSE_PLAYER_TWO=WORKER
# ROLE_REUSE_PAYOUT_TRIGGER=WORKER
# ROLE_REUSE_WORKER=DEPLOYER
# ROLE_REUSE_DEPLOYER=ORGANIZER
PRIZERAIL_DEPLOYMENT_MANIFEST=evidence/current-deployment.json
CORS_ALLOWED_ORIGINS=http://localhost:4173
PORT=3000
# Optional isolated port for the live worker/API evidence runner; absence selects a free port.
LIVE_WORKER_API_PORT=3011
# Local static development server; never set on Render or Vercel.
PRIZERAIL_FRONTEND_PORT=4173
HOST=127.0.0.1
PRIZERAIL_DATA_DIR=.data/prizerail

# Optional operations
WORKER_CONFIRMATIONS=1
WORKER_SOURCE_START_BLOCK=
WORKER_BATCH_SIZE=100
WORKER_POLL_INTERVAL_MS=15000
WORKER_MAX_ATTEMPTS=12
WORKER_LEASE_TTL_MS=60000
WORKER_REORG_REWIND=6
WORKER_AUTO_CLAIM=false

# Read-only verifier controls (local only; normal defaults shown).
VERIFY_DEMO_RPC_TIMEOUT_MS=8000
VERIFY_DEMO_STOP_ON_FAIL=0
VERIFY_EVIDENCE_RPC_TIMEOUT_MS=8000
VERIFY_EVIDENCE_SKIP_RPC=0
